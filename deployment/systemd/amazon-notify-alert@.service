[Unit]
Description=Amazon Notify restart-storm alert for %i
After=network-online.target

[Service]
Type=oneshot
User=YOUR_USER
WorkingDirectory=/opt/amazon-notify
EnvironmentFile=-/opt/amazon-notify/deployment/systemd/amazon-notify-alert.env
ExecStart=/opt/amazon-notify/.venv/bin/python /opt/amazon-notify/deployment/systemd/notify_on_failure.py %i
